# Required on the Render Web Service.
FORMA_DEPLOYMENT=render
NODE_ENV=production
HOST=0.0.0.0
APP_ORIGIN=https://www.example.com
PUBLIC_API_ORIGIN=https://api.example.com

# Optional additional API hostnames, comma-separated and without schemes.
# ALLOWED_HOSTS=your-api.onrender.com

# Use a dedicated Atlas database user. Supply the URI as a backend secret.
MONGODB_URI=
# Choose an unused database name on the cluster. The backend initializes it on startup.
MONGODB_DATABASE=forma_realestate_dev

STORAGE_DRIVER=mongodb
# Optional alternative: set STORAGE_DRIVER=r2 and supply private bucket credentials.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

CUSTOMER_MAIL_MODE=brevo-api
CUSTOMER_MAIL_FROM=noreply@example.com
BREVO_API_KEY=

# Private ClamAV hostname, reachable from the API over TCP port 3310.
CLAMD_HOST=

# Render supplies PORT. Public administrator setup stays disabled.
